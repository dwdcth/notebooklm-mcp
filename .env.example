# MCP 服务鉴权 key (客户端以 Authorization: Bearer <key> 访问)
MCP_API_KEY=change-me-to-a-long-random-string
# 监听地址: 本机用 127.0.0.1; VPS 上建议仍用 127.0.0.1 + SSH 隧道访问
MCP_HOST=127.0.0.1
MCP_PORT=8422
# artifact 下载目录
MCP_DOWNLOAD_DIR=~/.notebooklm/downloads
# notebooklm 账号 profile (cookie 位于 $NOTEBOOKLM_HOME/profiles/<profile>/)
NOTEBOOKLM_PROFILE=default
# 反代子路径 (直接访问留空)
MCP_PATH_PREFIX=/mcp
UI_PATH_PREFIX=
# 出口 IP 被 NotebookLM 拒绝时(机房 IP 常见), Google 请求走自备代理出口
# HTTPS_PROXY=http://127.0.0.1:8443
